# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap.xml and Open Graph tags.
# Local:      http://localhost:3000
# Production: https://www.arifaoverseas.com   (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email delivery (contact form + job applications) ──────────
# Where enquiries and applications are delivered.
EMAIL_TO=arifaoverseas786@gmail.com

# The From: address. With Gmail SMTP this must be the same account as SMTP_USER.
EMAIL_FROM=arifaoverseas786@gmail.com

# SMTP transport.
# Gmail: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and paste the 16 characters below —
# your normal Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=arifaoverseas786@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Supabase (admin + content database) ───────────────────────
# Dashboard → Project Settings → Data API.
# Both are safe in the browser: Row Level Security decides what they can do.
# Leave them blank and the site serves its built-in content with no admin.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The service-role key is deliberately NOT used by this app. Never add it here:
# it bypasses every RLS policy, and anything in .env reaches the server bundle.
